@@ -153,6 +153,24 @@ find_correct_mount_paths() {
     echo "  Vendor root: $VENDOR_ROOT"
 }
 
+# Screen readers: route the key events WSA injects through the accessibility input filter
+# (see a11y-keys/README.md). Needs SMALI_JAR and BAKSMALI_JAR; skipped when the patcher is absent.
+patch_a11y_keys() {
+    local patcher
+    patcher="$(realpath ./a11y-keys)/wsa_a11y_keys.py"
+    if [ ! -f "$patcher" ]; then
+        echo "a11y-keys patcher not found, skipping"
+        return 0
+    fi
+    local rc=0
+    sudo python3 "$patcher" --system "$SYSTEM_ROOT" --smali "$SMALI_JAR" --baksmali "$BAKSMALI_JAR" || rc=$?
+    case $rc in
+        0) ;;
+        2) echo "Warning: a11y-keys patch does not fit this build, skipped" ;;
+        *) abort "a11y-keys patch failed" ;;
+    esac
+}
+
 # Function to make changes (install Houdini)
 make_changes() {
     echo "=== Making Changes (Installing Houdini) ==="
@@ -425,6 +443,9 @@ process_wsa_image "vendor" "$VENDOR_TARGET_SIZE"
 # Make changes (install Houdini)
 make_changes
 
+# Accessibility key routing for screen readers
+patch_a11y_keys
+
 # Finalize system image
 finalize_wsa_image "system"
 
